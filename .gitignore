# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env
.env
.env.local
.env.*.local

# auth server secrets and data — never commit these
server/.env
server/data/
server/auth-server.log
*.tmp

# editor / OS
.DS_Store
.idea/
*.swp

# local OCR (PaddleOCR) — venv, downloaded models, python caches, temp page
# images and service logs are all local artifacts and must never be committed.
.venv-ocr/
server/ocr/__pycache__/
**/__pycache__/
*.pyc
.paddleocr/
server/ocr/models/
server/ocr/*.log
server/data/ocr-tmp/
ocr-service.log
