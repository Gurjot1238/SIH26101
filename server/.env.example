# NEXORA AI auth server configuration
#
# Copy this file to server/.env and edit it. server/.env is gitignored and must
# never be committed. Nothing in this repo contains a real secret.
#
#   cp server/.env.example server/.env
#
# Generate a session secret with:
#
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"

# Signs the session tokens stored on disk. At least 32 characters.
# If you leave this blank the server still runs, but it makes up a new secret on
# every start, which signs everybody out whenever you restart it.
SESSION_SECRET=

# Where the server listens.
AUTH_PORT=4000
AUTH_HOST=127.0.0.1

# Browser origins allowed to call this API, comma separated, no trailing slash.
# These are the two addresses the Vite dev server uses.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long a session lasts. 168 hours = 7 days.
SESSION_TTL_HOURS=168

# Leave false for local http. Set to true only when the site is served over
# https, otherwise the browser will refuse to store the cookie.
COOKIE_SECURE=false

# Set to true only when running behind a reverse proxy you control, so
# X-Forwarded-For can be trusted for rate limiting.
TRUST_PROXY=false

# Rate limits.
#
# SIGNUP_ATTEMPT_LIMIT is the loose budget: how many times per hour one IP may
# hit the signup endpoint at all, including attempts rejected for a weak
# password. SIGNUP_LIMIT is the strict one: how many accounts an IP may actually
# create per hour. Only a successful creation spends it, so someone who fumbles
# the form a few times is never locked out.
SIGNUP_ATTEMPT_LIMIT=40
SIGNUP_LIMIT=5

# Failed logins per account and per IP, per 15 minutes. A correct login clears
# the per-account counter.
LOGIN_LIMIT=8
LOGIN_IP_LIMIT=30

# Password hashing cost. Higher N is slower and more memory-hungry, which is the
# point. 32768 is roughly 32 MB and 100 ms per attempt. Changing this does not
# invalidate existing passwords.
SCRYPT_COST_N=32768
SCRYPT_BLOCK_SIZE=8
SCRYPT_PARALLELISM=1

# Where the JSON data files live. Defaults to server/data.
# AUTH_DATA_DIR=

# ---------------------------------------------------------------------------
# Storage backend
# ---------------------------------------------------------------------------
#
# Leave DATABASE_URL blank and the server stores everything in the JSON files
# under AUTH_DATA_DIR — the zero-dependency default, fine for local dev.
#
# Set DATABASE_URL and the server stores everything in PostgreSQL instead:
# users, sessions, assessment attempts, competency profiles, saved papers, the
# anonymised learning-interaction log, and the whole document-intelligence
# subtree (documents, chunks, staged pages, jobs). This is the production path —
# it gives reliable multi-user concurrency and durable data across restarts.
#
# One-time setup on the machine that has Postgres:
#
#   createdb nexora
#   npm install                                  # pulls in the pg driver
#   DATABASE_URL=postgres://localhost:5432/nexora npm run db:migrate   # JSON -> PG
#   DATABASE_URL=postgres://localhost:5432/nexora npm run db:verify    # proof
#
# Then run the server with the same DATABASE_URL set and it uses PostgreSQL.
# The schema is created automatically on first connection, so db:migrate is only
# needed if you have existing JSON data to bring across.
# DATABASE_URL=postgres://localhost:5432/nexora

# TLS to the database. Leave blank for a local socket/plain TCP. Set PGSSL=require
# for a managed provider that needs TLS (or put sslmode=require in the URL).
# PGSSL=require

# Connection pool size. Defaults to 10, which is plenty for one server process.
# PGPOOL_MAX=10

# ---------------------------------------------------------------------------
# AI question generation
# ---------------------------------------------------------------------------
#
# This is what makes the Materials page able to write questions. There are two
# ways to provide the model, and you pick one with AI_PROVIDER.
#
#   local   — a model running on this Mac. Free, private, no key, no account.
#             Nothing you upload leaves the machine. Slower than the cloud, and
#             the first request has to load the model into memory.
#   gemini  — Google's API. Fast, needs a key, and the document text is sent to
#             Google.
#
# Either way the questions are checked against your document before they are
# returned, so the honesty rules do not change with the provider. If the model
# cannot produce enough well-grounded questions you get a short set and a clear
# message, never invented filler.
#
# Leave this section as it ships and the feature reports itself unavailable
# rather than quietly generating questions some other way. That is deliberate: a
# quiz labelled "AI generated" must actually have come from the AI.

# Which provider to call: local | gemini | mock.
# "mock" is for the test suite and returns canned text from server/ai-fixtures
# instead of calling anything. Never use it for a demo.
AI_PROVIDER=gemini

# --- if AI_PROVIDER=local --------------------------------------------------
#
# Install Ollama from https://ollama.com, then in a terminal:
#
#   ollama pull gpt-oss:20b
#   ollama serve          (usually already running after install)
#
# Nothing below needs changing for a default Ollama install. AI_LOCAL_URL is
# only for pointing at a different port or a different OpenAI-compatible server
# — LM Studio is http://127.0.0.1:1234/v1.
#
# Use 127.0.0.1 rather than localhost: on macOS "localhost" can resolve to IPv6
# first, and Ollama listens on IPv4 only, which looks exactly like it being down.
# AI_LOCAL_URL=http://127.0.0.1:11434/v1
#
# How long to wait. The default is 180000 (three minutes), which is generous on
# purpose: loading a 20B model for the first time can take over a minute.
# AI_LOCAL_TIMEOUT_MS=180000

# --- if AI_PROVIDER=gemini -------------------------------------------------
#
# This key is read by the server process and by nothing else: it is never sent
# to the browser, never read through Vite, and never stored in the material
# session. Anything prefixed VITE_ is compiled into the bundle and readable by
# any visitor, so a key must never be given that prefix.
#
# Get a key at https://aistudio.google.com/apikey and paste it into server/.env,
# which is gitignored. Never put it in this file.
GEMINI_API_KEY=

# Which model to ask. Leave blank for the provider's default — gemini-1.5-flash
# for gemini, gpt-oss:20b for local. Set it to use a different one, for example
# llama3.1:8b if 20B is too slow on your machine.
AI_MODEL=

# Generation requests allowed per IP per hour. For gemini each one costs a
# provider call, so this is the budget guard as much as the abuse guard — a good
# positive default. Setting 0 means "no limit"; that is only honoured for a local
# model (AI_PROVIDER=local), where a request costs your own CPU and nothing else.
# With a metered provider (gemini) the server refuses to run unlimited and clamps
# 0 back to a safe cap, because an uncapped paid endpoint is an open-ended bill.
AI_GENERATION_LIMIT=30

# AI_MOCK_FILE and AI_MOCK_DIR are read only when AI_PROVIDER=mock. They belong
# to the test suite (npm run ai:test sets them itself) and have no place in a
# real server/.env.

# ---------------------------------------------------------------------------
# Competency target levels (the gap chart on the Dashboard)
# ---------------------------------------------------------------------------
#
# After an assessment, the Dashboard shows each competency against a target
# level and the shortfall between them. Those targets are NEXORA AI's own
# demonstration defaults for a mid-level statistical officer — data-quality 80,
# inference 75, dissemination 70, digital-tools 70, leadership 65. They are NOT
# an official MoSPI, FRAC or iGOT Karmayogi requirement, and the Dashboard says
# so wherever the chart appears.
#
# To use your own targets, set this to comma-separated id=percent pairs. Any id
# you omit keeps its default; an unknown id or an out-of-range number is ignored
# rather than crashing the server, and the Dashboard flags that custom targets
# are in force. Leave it blank to ship the demonstration defaults.
#
#   COMPETENCY_TARGETS=inference=90,leadership=55
# COMPETENCY_TARGETS=

# ---------------------------------------------------------------------------
# OCR for scanned PDFs (optional) — local engine OR hosted PaddleOCR API
# ---------------------------------------------------------------------------
#
# Some PDFs are scans or photos: the pages carry no selectable text, so the
# normal in-browser extraction comes back almost empty. When OCR is enabled the
# browser rasterises only those low-text pages and posts each page image to
# /api/documents/ocr-page, which forwards it to the configured OCR provider.
# The recognised text then flows through the SAME chunk -> index -> retrieve ->
# AI pipeline as normal text. The PDF file itself is still never uploaded.
#
# Two providers, chosen by OCR_PROVIDER (see below):
#   * local        — inference runs on THIS machine via PaddleOCR (.venv-ocr).
#                    No cloud API, no key, no document content leaves the box.
#                    The dev/fallback default.
#   * official_api — the hosted PaddleOCR Official API (production). No local
#                    Python, no .venv-ocr. Needs PADDLEOCR_ACCESS_TOKEN in the
#                    SERVER environment (never the frontend). Only page images
#                    are sent, one job per page.
#   * disabled     — skip OCR entirely (identical to OCR_ENABLED=false).
#
# This is entirely optional:
#   * With OCR_ENABLED=false (or OCR_PROVIDER=disabled), or the engine not
#     available, normal text PDFs work exactly as before; only genuinely scanned
#     pages get an honest "OCR unavailable" message instead of silent empty text.
#
# One-time setup for the LOCAL engine on the Mac (already done if .venv-ocr exists):
#
#   python3 -m venv .venv-ocr
#   ./.venv-ocr/bin/pip install -r server/ocr/requirements-ocr.txt
#
# `npm run dev` then starts the local OCR service alongside Vite automatically.

# Master switch. false → the server behaves exactly as it did before OCR.
OCR_ENABLED=true

# Which engine backs a scanned page: local | official_api | disabled.
# An unrecognised value falls back to 'local' so a typo can never silently turn a
# scanned page into a blind call to the cloud. Production uses official_api.
OCR_PROVIDER=local

# ---- local provider settings (OCR_PROVIDER=local) -------------------------
# The service binds to loopback only. A public bind is not a supported setup.
OCR_HOST=127.0.0.1
OCR_PORT=8091

# Per-request timeout (ms). Generous because PaddleOCR's first call also loads
# the recognition model into memory.
OCR_TIMEOUT_MS=30000

# Interpreter that has paddleocr installed. Relative paths resolve from the repo
# root. Defaults to the venv the setup step creates.
OCR_PYTHON=.venv-ocr/bin/python

# Recognition language and rasterisation resolution.
OCR_LANG=en
OCR_DPI=200

# Safety caps: at most this many pages are OCR'd per document, and the page-image
# route rejects anything larger than OCR_MAX_IMAGE_BYTES.
OCR_MAX_PAGES=200
OCR_MAX_IMAGE_BYTES=12582912

# OCR_ENGINE=stub makes the Python service return deterministic fixture text
# WITHOUT importing paddle. It exists only for the automated test suite
# (npm run ocr:test sets it itself) and must never be used for a real server.
# OCR_ENGINE=paddle

# ---- hosted provider settings (OCR_PROVIDER=official_api) ------------------
# The production OCR path: the hosted PaddleOCR Official API. No local Python,
# no .venv-ocr. Each scanned page image is submitted as an async job, polled to
# completion, and its JSONL result parsed into the SAME normalised text the local
# engine returns — so chunk -> index -> retrieve -> AI is identical either way.
#
# SECURITY: PADDLEOCR_ACCESS_TOKEN is a SERVER-SIDE secret. Never put it in
# frontend code, Vite/VITE_* variables, git, logs, or API responses. The browser
# only ever talks to Nexora's backend; the token is used solely in the
# Authorization header from the server to the API host, and is never sent to the
# object-storage result URL. Leave it EMPTY here and set the real value only in
# server/.env (git-ignored). Empty token → the provider answers
# "Cloud OCR is not configured" instead of making a blind, unauthenticated call.
PADDLEOCR_ACCESS_TOKEN=

# Async jobs endpoint. Submit = POST here; poll = GET <url>/<jobId>.
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# Authorization scheme prefix. The hosted example uses `bearer <token>`.
PADDLEOCR_AUTH_SCHEME=bearer
# Model label sent with each job.
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
# Chart-structure extraction. OFF by default: it is slower and unnecessary for
# text pages, and must not be enabled globally. Turn on only where a deployment
# genuinely wants chart parsing.
PADDLEOCR_USE_CHART_RECOGNITION=false
# Bounds so a single page can never hang forever (all ms except the byte cap).
PADDLEOCR_SUBMIT_TIMEOUT_MS=30000
PADDLEOCR_POLL_TIMEOUT_MS=8000
PADDLEOCR_POLL_INTERVAL_MS=1500
PADDLEOCR_POLL_MAX_MS=90000
PADDLEOCR_RESULT_TIMEOUT_MS=30000
PADDLEOCR_MAX_RESULT_BYTES=33554432
# Confidence reported when the hosted result carries no per-line scores (VL
# parsing often omits them). Kept in [0,1].
PADDLEOCR_DEFAULT_CONFIDENCE=0.9
