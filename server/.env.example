# NEXORA AI auth server configuration
#
# Copy this file to server/.env and edit it. server/.env is gitignored and must
# never be committed. Nothing in this repo contains a real secret.
#
#   cp server/.env.example server/.env
#
# Generate a session secret with:
#
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"

# Signs the session tokens stored on disk. At least 32 characters.
# If you leave this blank the server still runs, but it makes up a new secret on
# every start, which signs everybody out whenever you restart it.
SESSION_SECRET=

# Where the server listens.
AUTH_PORT=4000
AUTH_HOST=127.0.0.1

# Browser origins allowed to call this API, comma separated, no trailing slash.
# These are the two addresses the Vite dev server uses.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long a session lasts. 168 hours = 7 days.
SESSION_TTL_HOURS=168

# Leave false for local http. Set to true only when the site is served over
# https, otherwise the browser will refuse to store the cookie.
COOKIE_SECURE=false

# Set to true only when running behind a reverse proxy you control, so
# X-Forwarded-For can be trusted for rate limiting.
TRUST_PROXY=false

# Rate limits.
#
# SIGNUP_ATTEMPT_LIMIT is the loose budget: how many times per hour one IP may
# hit the signup endpoint at all, including attempts rejected for a weak
# password. SIGNUP_LIMIT is the strict one: how many accounts an IP may actually
# create per hour. Only a successful creation spends it, so someone who fumbles
# the form a few times is never locked out.
SIGNUP_ATTEMPT_LIMIT=40
SIGNUP_LIMIT=5

# Failed logins per account and per IP, per 15 minutes. A correct login clears
# the per-account counter.
LOGIN_LIMIT=8
LOGIN_IP_LIMIT=30

# Password hashing cost. Higher N is slower and more memory-hungry, which is the
# point. 32768 is roughly 32 MB and 100 ms per attempt. Changing this does not
# invalidate existing passwords.
SCRYPT_COST_N=32768
SCRYPT_BLOCK_SIZE=8
SCRYPT_PARALLELISM=1

# Where the JSON data files live. Defaults to server/data.
# AUTH_DATA_DIR=
